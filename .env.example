MODEL_API_KEY=
YAAD_MODEL=muse-spark-1.3
YAAD_DB_PATH=~/.yaad/yaad.sqlite3
YAAD_CLOUD_ENABLED=false
YAAD_MAX_SCANNED_PDF_PAGES=30
YAAD_AUDIO_MAX_MINUTES=10
# Model provider: "cloud" (Meta Model API, default) or "local" (Ollama runtime).
# The two YAAD_LOCAL_* values below only take effect when provider is "local".
YAAD_MODEL_PROVIDER=cloud
# Ollama API base URL (no trailing path). Keep loopback to keep prompts on-device.
YAAD_LOCAL_ENDPOINT=http://localhost:11434
# Model name as known to your Ollama runtime; pull it first (see docs/LOCAL_INFERENCE.md).
YAAD_LOCAL_MODEL=muse-glimmer:30b
# --- Optional settings (defaults shown; see yaad/config.py) ---
# Automatic background memory learning after indexing/conversation.
YAAD_AUTO_MEMORY=true
# Opt-in local semantic (embedding) retrieval channel; needs the [semantic] extra.
YAAD_SEMANTIC_RETRIEVAL=false
YAAD_SEMANTIC_MIN_SIMILARITY=0.30
# Spend ceilings in USD (0 disables the indexing/global caps).
YAAD_REVIEW_MAX_SPEND_USD=0.05
YAAD_PIPELINE_STAGE_MAX_SPEND_USD=0.05
YAAD_VERIFY_MODEL_VOTES=1
YAAD_INDEX_MAX_SPEND_USD=0
YAAD_CLOUD_SPEND_CAP_USD=0
# Allow a non-loopback YAAD_LOCAL_ENDPOINT (e.g. a LAN inference box).
YAAD_LOCAL_ALLOW_REMOTE=false
# Shared API token. Required to bind a non-loopback host (yaad serve --host);
# when set, /api/* requires "Authorization: Bearer <token>".
YAAD_API_TOKEN=
# Capability-suite usage log path (tooling only).
CAPABILITY_USAGE_PATH=docs/capability_usage.json
