MODEL_API_KEY=
YAAD_MODEL=muse-spark-1.3
YAAD_DB_PATH=~/.yaad/yaad.sqlite3
YAAD_CLOUD_ENABLED=false
YAAD_MAX_SCANNED_PDF_PAGES=30
YAAD_AUDIO_MAX_MINUTES=10
# Model provider: "cloud" (Meta Model API, default) or "local" (Ollama runtime).
# The two YAAD_LOCAL_* values below only take effect when provider is "local".
YAAD_MODEL_PROVIDER=cloud
# Ollama API base URL (no trailing path). Keep loopback to keep prompts on-device.
YAAD_LOCAL_ENDPOINT=http://localhost:11434
# Model name as known to your Ollama runtime; pull it first (see docs/LOCAL_INFERENCE.md).
YAAD_LOCAL_MODEL=muse-glimmer:30b
